{{!< default}}
{{#is "home"}}
    {{#match pagination.page "=" 1}}
        <section class="wrap intro intro-home">
            <h1 aria-label="Da ideia ao produto. Hora de construir, testar e melhorar.">Da ideia ao produto. Hora de <em class="intro-words" aria-hidden="true"><span class="intro-word" style="animation-delay: 0s">construir.</span><span class="intro-word" style="animation-delay: -15s">testar.</span><span class="intro-word" style="animation-delay: -12s">analisar.</span><span class="intro-word" style="animation-delay: -9s">refinar.</span><span class="intro-word" style="animation-delay: -6s">melhorar.</span><span class="intro-word" style="animation-delay: -3s">idealizar.</span></em></h1>
        </section>
    {{/match}}
{{/is}}

{{#if posts}}
    <div class="wrap home-content">
        {{#match pagination.total ">" 1}}
            {{#foreach posts}}
                {{#if @first}}
                    {{> featured}}
                {{/if}}
            {{/foreach}}
        {{/match}}

        {{#is "home"}}
            {{#match pagination.page "=" 1}}
                <section class="proj-home" aria-labelledby="projetos-titulo">
                    <div class="section-head">
                        <div class="section-title">
                            <h2 id="projetos-titulo">Projetos em andamento</h2>
                            <span class="section-note">Fora do blog, o que estou construindo.</span>
                        </div>
                        <a class="proj-home-all" href="{{@site.url}}/projetos/">Ver os {{> "projetos/total"}} projetos <span aria-hidden="true">↗</span></a>
                    </div>
                    <div class="proj-home-grid">
                        {{> "projetos/dados" modo="home"}}
                    </div>
                </section>
            {{/match}}
        {{/is}}

        <div class="editorial editorial-home">
            <section class="feed" id="artigos">
                <div class="section-head">
                    <h2>As últimas descobertas</h2>
                    <span class="section-count">{{plural pagination.total empty="Nenhum artigo" singular="% artigo" plural="% artigos"}}</span>
                </div>

                <div class="grid grid-home">
                    {{#match pagination.total ">" 1}}
                        {{#foreach posts}}
                            {{#unless @first}}
                                {{> card}}
                            {{/unless}}
                        {{/foreach}}
                    {{else}}
                        {{#foreach posts}}
                            {{> card}}
                        {{/foreach}}
                    {{/match}}
                </div>

                {{> pagination}}
            </section>

            {{> assuntos compact=true}}
        </div>
    </div>

    <section class="wrap closing">
        <span class="eyebrow">Não precisa caber numa caixinha</span>
        <h2>Uma boa descoberta puxa a próxima.</h2>
        <a href="#artigos">Encontre sua próxima leitura <span aria-hidden="true">↗</span></a>
    </section>
{{else}}
    <div class="wrap home-content">
        <div class="editorial editorial-home">
            <section class="feed">
                <section class="empty-state">
                    <span class="eyebrow">Ainda no rascunho</span>
                    <h1>Nada publicado por aqui ainda.</h1>
                    <p>O primeiro artigo está a caminho. Enquanto isso, volte em breve ou acompanhe pelo <a href="{{@site.url}}/rss/">RSS</a>.</p>
                </section>
            </section>
            {{> assuntos compact=true}}
        </div>
    </div>
{{/if}}

{{#is "home"}}
    {{#match pagination.page "=" 1}}
        <div class="wrap home-signoff">
            <p class="intro-sign">Um blog para quem é curioso · Por Maycon Rocha</p>
        </div>
    {{/match}}
{{/is}}
