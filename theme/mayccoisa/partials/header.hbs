<header class="site-head">
    <div class="wrap nav-bar">
        <a class="brand" href="{{@site.url}}" aria-label="{{@site.title}} — página inicial">
            {{#if @site.logo}}
                <img class="brand-logo" src="{{@site.logo}}" alt="{{@site.title}}" />
            {{else}}
                <img class="brand-mark" src="{{asset "images/marca.png"}}" alt="" width="36" height="36" />
                <span class="brand-word">{{@site.title}}</span>
            {{/if}}
        </a>

        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-principal">
            <span class="menu-bars" aria-hidden="true"></span>
            <span class="menu-text">Menu</span>
        </button>

        <div class="nav-area" id="menu-principal">
            <nav class="nav-links" aria-label="Navegação principal">
                {{navigation}}
            </nav>

            <button class="nav-search" type="button" data-ghost-search aria-label="Buscar no site">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M14.95 14.95a1 1 0 0 1 1.41 0l6.34 6.34a1 1 0 0 1-1.41 1.41l-6.34-6.34a1 1 0 0 1 0-1.41Z" fill="currentColor"/>
                    <path d="M10 3a7 7 0 1 0 0 14 7 7 0 0 0 0-14Zm-9 7a9 9 0 1 1 18 0 9 9 0 0 1-18 0Z" fill="currentColor"/>
                </svg>
            </button>

            <a class="nav-cta" href="{{@site.url}}/#artigos">Bora explorar <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</header>
