        oque="Editor de blocos para React, no estilo do Notion, construído sobre o ProseMirror."
        onde="É o editor de documentos do Product Hub."
        porque="Entrega um editor de blocos pronto, com menu de comandos e arrastar blocos, que dá para ligar numa aplicação React em pouco tempo."}}

    {{> "referencias/item"
        repo="excalidraw/excalidraw" destino="https://github.com/excalidraw/excalidraw" tipo_nome="Quadro e diagramas"
