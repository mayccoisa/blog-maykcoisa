{{!-- Google Analytics 4. Só renderiza com o ID de métricas preenchido (G-XXXXXXXXXX).
      O ID é passado por default.hbs. Sem ID, nada é carregado. --}}
{{#if ga_id}}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ga_id}}"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', '{{ga_id}}');
</script>
{{/if}}
