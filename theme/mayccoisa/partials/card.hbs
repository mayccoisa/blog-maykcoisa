<article class="card">
    <a class="card-link" href="{{url}}">
        <div class="card-art{{#if feature_image}}{{else}} label-art{{/if}}">
            {{#if feature_image}}
                <img
                    src="{{img_url feature_image size="m"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="lazy"
                    width="600"
                    height="380"
                />
            {{else}}
                <span class="label-text">{{#if primary_tag}}{{primary_tag.name}}{{else}}{{@site.title}}{{/if}}</span>
                <span class="label-mark" aria-hidden="true">m.</span>
            {{/if}}
        </div>

        <span class="tag">{{#if primary_tag}}{{primary_tag.name}}{{else}}Blog{{/if}}</span>
        <h3>{{title}}</h3>
        <p>{{excerpt characters="130"}}</p>
        <div class="meta">
            {{date format="D MMM YYYY" locale="pt-BR"}} <span aria-hidden="true">·</span>
            {{reading_time minute="1 min de leitura" minutes="% min de leitura"}}
        </div>
    </a>
</article>
