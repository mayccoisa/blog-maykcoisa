{{!-- Capa do projeto. Com "capa", usa a imagem real em duotom; sem ela, desenha a
      arte da marca: fundo e motivo pelo tipo, sigla grande do projeto. --}}
<div class="proj-capa proj-capa-{{tipo}}{{#if capa}} duo{{/if}}" role="img" aria-label="Capa do projeto {{nome}}">
    {{#if capa}}
        <img src="{{capa}}" alt="" loading="lazy" />
    {{else}}
        <svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
            <rect class="c-bg" width="320" height="180" />
            {{#match tipo "jogos"}}
                <rect class="c-line" x="196" y="46" width="60" height="86" rx="8" transform="rotate(-14 226 89)" />
                <rect class="c-line" x="232" y="46" width="60" height="86" rx="8" transform="rotate(14 262 89)" />
                <rect class="c-accent" x="214" y="38" width="60" height="86" rx="8" />
                <circle class="c-bg" cx="244" cy="81" r="12" />
            {{/match}}
            {{#match tipo "playnite"}}
                <rect class="c-line" x="178" y="38" width="36" height="48" rx="6" />
                <rect class="c-accent" x="222" y="38" width="36" height="48" rx="6" />
                <rect class="c-line" x="266" y="38" width="36" height="48" rx="6" />
                <rect class="c-line" x="178" y="94" width="36" height="48" rx="6" />
                <rect class="c-line" x="222" y="94" width="36" height="48" rx="6" />
                <rect class="c-line" x="266" y="94" width="36" height="48" rx="6" />
            {{/match}}
            {{#match tipo "ferramentas"}}
                <rect class="c-line" x="166" y="34" width="134" height="104" rx="8" />
                <path class="c-stroke" d="M166 54h134" />
                <circle class="c-dot" cx="178" cy="44" r="3" />
                <circle class="c-dot" cx="188" cy="44" r="3" />
                <circle class="c-dot" cx="198" cy="44" r="3" />
                <path class="c-accent-stroke" d="M180 72l10 8-10 8" />
                <path class="c-stroke" d="M198 88h36M180 104h80M180 118h56" />
            {{/match}}
            {{#match tipo "pm"}}
                <rect class="c-line" x="172" y="34" width="38" height="112" rx="6" />
                <rect class="c-line" x="218" y="34" width="38" height="112" rx="6" />
                <rect class="c-line" x="264" y="34" width="38" height="112" rx="6" />
                <rect class="c-accent" x="178" y="42" width="26" height="20" rx="3" />
                <rect class="c-dot" x="178" y="68" width="26" height="20" rx="3" />
                <rect class="c-dot" x="224" y="42" width="26" height="20" rx="3" />
                <rect class="c-dot" x="270" y="42" width="26" height="20" rx="3" />
                <rect class="c-dot" x="270" y="68" width="26" height="20" rx="3" />
                <rect class="c-dot" x="270" y="94" width="26" height="20" rx="3" />
            {{/match}}
            <text class="c-sigla" x="22" y="146">{{sigla}}</text>
        </svg>
    {{/if}}
</div>
