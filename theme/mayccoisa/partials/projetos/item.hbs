{{!-- Um projeto da lista. "modo" vem de quem chamou partials/projetos/dados. --}}
{{#match modo "destaque"}}
    {{#match destaque "sim"}}
        <article class="featured proj-featured" data-tipo="{{tipo}}" aria-label="Projeto em destaque">
            {{#if artigo}}<a class="proj-capa-link" href="{{@site.url}}{{artigo}}" tabindex="-1" aria-hidden="true">{{> "projetos/capa"}}</a>{{else}}{{> "projetos/capa"}}{{/if}}

            <div class="feature-copy">
                <span class="tag">{{tipo_nome}} · em destaque</span>
                <h2>{{#if artigo}}<a class="proj-titulo-link" href="{{@site.url}}{{artigo}}">{{nome}}</a>{{else}}{{nome}}{{/if}}</h2>
                <p>{{resumo}}</p>
                <div class="proj-info">
                    {{#if tec1}}<span class="proj-chip">{{tec1}}</span>{{/if}}
                    {{#if tec2}}<span class="proj-chip">{{tec2}}</span>{{/if}}
                    <span class="proj-date">Atualizado em <time datetime="{{data_iso}}">{{atualizado}}</time></span>
                </div>
                <div class="proj-foot proj-foot-featured">
                    {{> "projetos/selo"}}
                    {{> "projetos/link"}}
                </div>
            </div>
        </article>
    {{/match}}
{{/match}}

{{#match modo "grade"}}
    {{#match destaque "!=" "sim"}}
        <article class="proj-card" data-tipo="{{tipo}}">
            {{#if artigo}}<a class="proj-capa-link" href="{{@site.url}}{{artigo}}" tabindex="-1" aria-hidden="true">{{> "projetos/capa"}}</a>{{else}}{{> "projetos/capa"}}{{/if}}
            <div class="proj-cover">
                <span class="proj-type">{{tipo_nome}}</span>
                <h3>{{#if artigo}}<a class="proj-titulo-link" href="{{@site.url}}{{artigo}}">{{nome}}</a>{{else}}{{nome}}{{/if}}</h3>
            </div>
            <div class="proj-body">
                <p>{{resumo}}</p>
                <div class="proj-info">
                    {{#if tec1}}<span class="proj-chip">{{tec1}}</span>{{/if}}
                    {{#if tec2}}<span class="proj-chip">{{tec2}}</span>{{/if}}
                </div>
                <span class="proj-date">Atualizado em <time datetime="{{data_iso}}">{{atualizado}}</time></span>
            </div>
            <div class="proj-foot">
                {{> "projetos/selo"}}
                {{> "projetos/link"}}
            </div>
        </article>
    {{/match}}
{{/match}}

{{#match modo "home"}}
    {{#match home "sim"}}
        <article class="proj-mini">
            {{#if artigo}}<a class="proj-capa-link" href="{{@site.url}}{{artigo}}" tabindex="-1" aria-hidden="true">{{> "projetos/capa"}}</a>{{else}}{{> "projetos/capa"}}{{/if}}
            <span class="proj-type">{{tipo_nome}}</span>
            <h3>{{#if artigo}}<a class="proj-titulo-link" href="{{@site.url}}{{artigo}}">{{nome}}</a>{{else}}{{nome}}{{/if}}</h3>
            <p>{{resumo}}</p>
            <div class="proj-foot">
                {{> "projetos/selo"}}
                {{> "projetos/link"}}
            </div>
        </article>
    {{/match}}
{{/match}}
