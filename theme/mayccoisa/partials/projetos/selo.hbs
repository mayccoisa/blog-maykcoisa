{{else}}
    <span class="selo selo-privado">
        <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        {{#match acesso "entrega"}}Código privado{{else}}Privado{{/match}}
    </span>
{{/match}}
